{
  "name": "last-bastion-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/offline-boot-test.ps1",
    "balance:audit": "node scripts/run-balance-audit.mjs",
    "audio:validate:s1": "node scripts/validate-production-audio.mjs",
    "audio:audit:s23": "node scripts/audit-production-audio-s23.mjs",
    "audio:loudness:s23": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-production-audio-loudness-s23.ps1",
    "audio:encode:s23": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/encode-production-audio-s23.ps1",
    "audio:generate:s1": "node scripts/generate-production-audio-s1.mjs",
    "image:encode:webp": "python scripts/encode-production-images.py",
    "image:audit:webp": "node scripts/audit-production-images.mjs",
    "verify": "npm run image:audit:webp && npm run typecheck && npm run test && npm run build && npm run smoke && npm run offline"
  },
  "dependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
