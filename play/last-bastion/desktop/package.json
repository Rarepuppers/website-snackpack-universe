{
  "name": "last-bastion-desktop",
  "version": "0.0.1",
  "description": "Desktop host for the Last Bastion science-fiction survival game.",
  "author": "SnackPack Universe",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "npm run build && electron .",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop.ps1 -Platform win",
    "package:linux": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop.ps1 -Platform linux",
    "package:mac": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop.ps1 -Platform mac",
    "smoke:package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-host.ps1 -Executable release/win-unpacked/LastBastion.exe"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.snackpackuniverse.lastbastion",
    "productName": "Last Bastion",
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/game",
        "to": "game"
      },
      {
        "from": "stage/steam-input",
        "to": "steam-input"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "packaging-assets"
    },
    "win": {
      "executableName": "LastBastion",
      "icon": "packaging-assets/icon.ico"
    },
    "mac": {
      "icon": "packaging-assets/icon.icns"
    },
    "linux": {
      "icon": "packaging-assets/icon.png"
    }
  }
}
