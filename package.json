{
  "name": "snackpack-universe-website",
  "private": true,
  "scripts": {
    "report:referrals": "node scripts/report-referrals.mjs",
    "compose:atlas-guide-card": "node scripts/compose-atlas-guide-card.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:last-bastion": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-last-bastion-browser-tests.ps1",
    "verify:last-bastion": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-last-bastion.ps1",
    "measure:last-bastion": "playwright test --config playwright.last-bastion-startup.config.mjs",
    "screens:last-bastion": "playwright test --config playwright.last-bastion-screens.config.mjs",
    "profile:last-bastion": "playwright test --config playwright.last-bastion-profile.config.mjs",
    "capture:last-bastion": "node scripts/capture-last-bastion.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
